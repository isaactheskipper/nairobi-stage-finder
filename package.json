{
  "name": "stage-app",
  "version": "0.1.0",
  "private": true,
  "description": "STAGE — Premium Nairobi public transport & boarding-stage discovery platform",
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "start:mobile": "npm --prefix apps/mobile run start",
    "android:mobile": "npm --prefix apps/mobile run android",
    "typecheck:mobile": "npm --prefix apps/mobile run typecheck",
    "typecheck": "npm run typecheck:web && npm run typecheck:mobile"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

