# ============================================================================
# STAGE Nairobi — Map, Routing & Geocoding Environment Configuration (Example)
# Copy to apps/mobile/.env or apps/web/.env to override default endpoints.
# NO API KEYS ARE REQUIRED for the default $0 OpenFreeMap + OSRM + Nominatim setup.
# ============================================================================

EXPO_PUBLIC_OSRM_BASE_URL=https://routing.openstreetmap.de/routed-foot
EXPO_PUBLIC_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
EXPO_PUBLIC_MAPLIBRE_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
EXPO_PUBLIC_MAPLIBRE_STYLE_STANDARD=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_MAPLIBRE_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
