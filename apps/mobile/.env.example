# ============================================================================
# STAGE Nairobi Mobile — Map, Routing & Geocoding Environment Configuration
# Copy this file to `apps/mobile/.env` if you wish to override default URLs.
# NO API KEYS ARE REQUIRED for the default $0 OpenFreeMap + OSRM + Nominatim setup.
# ============================================================================

# 1. OSRM WALKING routing (foot profile, FOSSGIS public server, no API key).
# NOTE: router.project-osrm.org is CAR-ONLY (its /foot/ path returns driving routes),
# so it is not used. Public servers are best-effort; host your own for production.
EXPO_PUBLIC_OSRM_BASE_URL=https://routing.openstreetmap.de/routed-foot

# 2. OpenStreetMap Nominatim Place Search (No API key required for public OSMF server)
# Complies with OSMF Nominatim Usage Policy (explicit search button trigger, max 1 req/sec).
EXPO_PUBLIC_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search

# 3. OpenFreeMap MapLibre Vector Style URLs ($0, no API key or registration required)
# Note: These are MapLibre GL Style Specification JSON URLs, not raster PNG tile templates.
EXPO_PUBLIC_MAPLIBRE_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
EXPO_PUBLIC_MAPLIBRE_STYLE_STANDARD=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_MAPLIBRE_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
