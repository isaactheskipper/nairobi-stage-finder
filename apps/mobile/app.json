{
  "expo": {
    "name": "STAGE Nairobi",
    "slug": "stage-nairobi",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#111513"
    },
    "android": {
      "package": "ke.co.stage.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#111513"
      }
    },
    "plugins": [
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "STAGE uses your foreground location to show your position on the Nairobi map and calculate directions to your matatu boarding stage."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-font"
    ]
  }
}
