{
  "expo": {
    "name": "STAGE Nairobi",
    "slug": "stage-nairobi",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./src/assets/icon.png",
    "android": {
      "package": "ke.co.stage.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#111513"
      }
    },
    "plugins": [
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "STAGE uses your foreground location to show your position on the Nairobi map and calculate directions to your matatu boarding stage."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "2a733d5f-9882-4b6b-8bf3-ad547ede55d9"
      }
    }
  }
}
